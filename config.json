{
  "loginUrl": "https://fanar.gqb.org.sa/login",
  "ordersUrl": "https://fanar.gqb.org.sa/finance/orders/requests",

  "login": {
    "username": "input[type=email], input[name*=user i], input[name*=email i], input[id*=user i], input[type=text]",
    "password": "input[type=password]",
    "submit": "button[type=submit], input[type=submit]",
    "loggedInSelector": ""
  },

  "otp": {
    "input": "input[autocomplete=one-time-code], input[name*=otp i], input[name*=code i], input[id*=otp i]",
    "submit": "button[type=submit], input[type=submit]",
    "waitMinutes": 8
  },

  "orders": {
    "tabs": [
      "المرحلة الأولى",
      "المرحلة الثانية",
      "اعتماد مدير الإدارة",
      "المرحلة الثالثة",
      "عند الإدارة العامة",
      "بانتظار الإقفال",
      "المسيرات",
      "المكتملة",
      "معادة للدار",
      "المرفوضة",
      "حالة قديمة (عند المالية)"
    ],
    "showDetailsText": "عرض التفاصيل",
    "hideDetailsText": "إخفاء التفاصيل",
    "cardMarker": "المعاملة",
    "detailsMarker": "بيانات المستفيد",
    "maxMinutes": 35
  },

  "onlyMaintenance": {
    "field": "description",
    "contains": ["صيانة", "الصيانة"]
  },

  "fields": {
    "orderNo": "المعاملة",
    "amount": "المبلغ",
    "department": "القسم",
    "submitted": "التقديم",
    "description": "بيانات الصرف",
    "company": "بيانات المستفيد",
    "status": "المرحلة الحالية",
    "updated": "آخر تحديث"
  }
}
